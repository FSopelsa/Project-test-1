# Copy this file to .env and replace every change-me value.
# The local .env file is ignored by Git.
EVENT_DB_NAME=event_management
EVENT_DB_USER=event_app
EVENT_DB_PASSWORD=change-me
EVENT_DB_ROOT_PASSWORD=change-me
EVENT_DB_PORT=3307
EVENT_DB_URL=jdbc:mysql://localhost:3307/event_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
